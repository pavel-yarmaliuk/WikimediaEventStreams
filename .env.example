# Local (docker-compose)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Cloud (Neo4j AuraDB) — override these when not using docker-compose
# NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
# NEO4J_PASSWORD=<your-password>

# GitHub MCP server (for Claude Code issue context)
# Create a token at https://github.com/settings/tokens — needs: repo (read), issues (read)

# Logging (defaults shown — uncomment to override)
# LOG_DIR=logs
# LOG_LEVEL=INFO
# LOG_MAX_BYTES=10485760   # 10 MB; rotation threshold per file
# LOG_BACKUP_COUNT=5       # Number of rotated backups to keep
